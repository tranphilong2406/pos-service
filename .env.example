SERVER_PORT=8080
MONGO_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# Use release in production
GIN_MODE=release
# Enables pre-filling products from photos. Without it only that route is off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
